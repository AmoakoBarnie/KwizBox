# KwizBox backend — environment template
# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Local dev (default): SQLite file
DATABASE_URL=sqlite:///./trivia.db
# Production: a managed Postgres DSN (Supabase / Neon / Railway / RDS)
# DATABASE_URL=postgresql://user:password@host:5432/kwizbox?sslmode=require

# --- Secrets (REQUIRED — no default) ---
JWT_SECRET=generate-a-long-random-string-here
# Optional initial admin seed; without it, the API starts without creating an admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set-a-strong-admin-password

# --- Tokens ---
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ADMIN_TOKEN_EXPIRE_MINUTES=120

# --- One-off SQLite → Postgres migration ---
# Set these only when running backend/scripts/run_migrate.py.
# SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# SQLITE_PATH=./trivia.db
