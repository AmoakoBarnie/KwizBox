# KwizBox Environment Variables
# IMPORTANT: Set these values in the actual .env file uploaded to your server
# These are placeholders only - NEVER commit real credentials to version control

DB_HOST=${DB_HOST:-your-db-host.example.com}
DB_NAME=${DB_NAME:-your_db_name}
DB_USER=${DB_USER:-your_db_user}
DB_PASS=${DB_PASS:-your_db_password}
JWT_SECRET=${JWT_SECRET:-your_jwt_secret_here}
ALLOWED_ORIGINS=${ALLOWED_ORIGINS:-https://your-app.example.com}
ADMIN_USERNAME=${ADMIN_USERNAME:-admin}
ADMIN_PASSWORD=${ADMIN_PASSWORD:-your_admin_password}
ADMIN_FULLNAME=${ADMIN_FULLNAME:-Super Admin}