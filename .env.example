# KwizBox — Root Environment Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it holds secrets. .gitignore already excludes it.
# This file intentionally exposes only variable NAMES and descriptions.

# ---------------------------------------------------------------------------
# BACKEND (FastAPI) — shared by local dev, Docker, and production
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------
# Local development (default):
DATABASE_URL=sqlite:///./trivia.db
# Production (managed Postgres — Supabase, Neon, Railway, RDS):
# DATABASE_URL=postgresql://user:pass@host:5432/kwizbox?sslmode=require

# --- Secrets (REQUIRED, no defaults) ------------------------------------
# Generate a secure random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-long-random-string-here

# --- Token lifetimes (minutes) -------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=43200     # 30 days
ADMIN_TOKEN_EXPIRE_MINUTES=120        # 2 hours

# ---------------------------------------------------------------------------
# FRONTEND (Vite + React) — local dev and production
# ---------------------------------------------------------------------------

# Base URL of the backend API.
# Local dev (default):  http://localhost:8001
# Production (served same-origin by FastAPI): leave EMPTY.
VITE_API_URL=http://localhost:8001
